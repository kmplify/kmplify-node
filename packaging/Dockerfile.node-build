# Build environment for the fully-static Linux kmplify-node binary.
#
# Produces ONE binary that executes on any GUI-less Linux distribution:
# Ubuntu, Debian, openSUSE, CachyOS/Arch, Alpine, anything with a kernel.
# The musl target links everything statically and the crate is OpenSSL-free
# (rustls throughout), so there is no glibc version or system library to
# disagree about.
#
#   docker build -f packaging/Dockerfile.node-build -o dist-node .
#   -> dist-node/kmplify-node
#
# This is a BUILD image. The node itself runs on the host, next to the host's
# Docker daemon, not inside a container: it needs to see the real GPU and the
# real docker socket.
FROM rust:1-alpine AS build
RUN apk add --no-cache musl-dev git
WORKDIR /src
COPY Cargo.toml Cargo.lock build.rs ./
# NOTICE is compiled INTO the binary (kmplify_node::NOTICE, the Apache-2.0
# attribution embedders must ship), so the build fails without it.
COPY NOTICE LICENSE ./
COPY src ./src
# The build stamp reads git; a tarball build simply goes unstamped.
COPY .git ./.git
# Native per-arch: buildx sets TARGETARCH, so the same file produces the
# x86_64 binary on amd64 and the aarch64 one on arm64 (Apple Silicon, ARM
# VPS) without a cross toolchain.
ARG TARGETARCH
RUN case "$TARGETARCH" in \
      arm64) MUSL_TARGET=aarch64-unknown-linux-musl ;; \
      *)     MUSL_TARGET=x86_64-unknown-linux-musl ;; \
    esac \
 && rustup target add "$MUSL_TARGET" \
 && cargo build --release --target "$MUSL_TARGET" \
 && cp "target/$MUSL_TARGET/release/kmplify-node" /kmplify-node.out

FROM scratch AS export
COPY --from=build /kmplify-node.out /kmplify-node
