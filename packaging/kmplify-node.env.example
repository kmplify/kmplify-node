# /etc/kmplify-node.env: configuration for the kmplify-node systemd service.
# Every line here is an operator decision; the defaults below are the safest
# reading of each one. Full reference: docs/HEADLESS-NODE.md.
#
# Check a change before restarting into it — every variable here also has a
# flag, so nothing has to be edited to try it:
#   kmplify-node check --workloads vllm-openai --max-vram-mb 16000
# And watch the running service with the dashboard, as the service's user:
#   sudo -u kmplify KMPLIFY_NODE_DIR=/var/lib/kmplify-node kmplify-node tui
#
# A value that cannot be read (a ceiling that is not a number, a country that
# is not alpha-2) stops the node at startup naming the variable, rather than
# quietly falling back to a default you did not choose.
#
# NOTE: the sharing settings below can also be changed at runtime, from the
# dashboard's sharing screen or `kmplify-node set`. Those choices live in
# KMPLIFY_NODE_DIR/settings.json and OVERRIDE this file until cleared
# (`kmplify-node set --clear KEY`, or `d` on the row). `kmplify-node check`
# lists everything currently overriding this file, so a surprise here is
# always one command away from being explained.

# Gateway to join. Unset = the public KMPLIFY fabric. Point it at your own
# gateway to run a private fabric; the protocol is documented in PROTOCOL.md.
#PROVIDER_GATEWAY_URL=https://fabric.kmplify.io

# The local model server whose models this node serves. Any OpenAI-compatible
# endpoint works (Ollama, vLLM, LiteLLM, TGI, llama.cpp server).
#OLLAMA_BASE=http://127.0.0.1:11434

# Container sessions are OFF until you list template ids here. Running other
# people's workloads is a bigger grant than answering chat requests, so it is
# a separate, explicit choice. CUDA templates need docker + the NVIDIA
# container toolkit. Example: vllm-openai,vllm-openai-lmcache,comfyui,ollama,speaches
#PROVIDER_WORKLOADS=

# Ceilings on what sessions may take from this machine. Unset = the node's
# own conservative defaults (half the host's CPUs, the card's real VRAM).
#PROVIDER_MAX_CPUS=4
#PROVIDER_MAX_VRAM_MB=16000
#PROVIDER_MAX_RAM_MB=16000
#PROVIDER_MAX_DISK_GB=40

# Where this machine physically is (ISO alpha-2), so consumers can prefer
# EU/EEA capacity. Self-declared and unverifiable: a residency preference for
# THEM, not an attestation. Do not set it unless it is true.
#PROVIDER_COUNTRY=DE

# "auto" lets any consumer use this node; "manual" parks unknown consumers
# until you approve them (invitations always bypass the gate).
#PROVIDER_APPROVAL_MODE=auto

# Lend spare CPU threads and RAM alongside (or instead of) the GPU.
#PROVIDER_SHARE_CPU=false

# Serve model jobs at all. Off makes this a CPU/session-only node; the
# dashboard's pause key does the same thing temporarily, without a restart.
#PROVIDER_SHARE_INFERENCE=true

# Protocol v3.0 lanes, both off until you opt in.
# Signed Wasm functions need a build with `--features wasm` and the gateway's
# function key (GET /v1/functions -> pubkey). The node runs only modules
# signed by that key, in a sandbox with stdin/stdout and nothing else.
#PROVIDER_FUNCTIONS=false
#PROVIDER_FUNCTIONS_PUBKEY=
#PROVIDER_MAX_FUNCTION_MB=256
#PROVIDER_MAX_FUNCTION_MS=30000
# Lend storage for replicated vector collections (opaque payloads).
#PROVIDER_SHARE_VECTORS=false
#PROVIDER_MAX_VECTOR_MB=1024
